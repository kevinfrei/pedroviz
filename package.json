{
  "name": "@freik/pedroviz",
  "version": "0.2.2",
  "repository": "https://github.com/kevinfrei/pedroviz.git",
  "author": "Kevin Frei <kevinfrei@hotmail.com>",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "pedroviz": "./dist/entry.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "force-format": "prettier -w \"src/**/*.ts\" \"src/**/*.tsx\" \"*.md\" \"*.json\" \"src/**/*.md\" \"src/**/*.json\" \"src/**/*.html\" \"src/server/**/*.java\"",
    "format": "tools format bun",
    "foramt": "tools format bun",
    "fmt": "tools format bun",
    "types": "tsc --noEmit",
    "check": "bun run types && bun cycles && bun dead && bun test",
    "dev:launch": "sleep 1 && bun run dev/entry.js ../BioBuzz2026",
    "dev:bundle": "bun run dev-bundle.ts",
    "dev": "bun run --parallel dev:bundle dev:launch",
    "prod": "bun run dist/entry.js",
    "prod:bundle": "bun run prod-bundle.ts",
    "prepublishOnly": "bun run prod:bundle",
    "cycles": "knip --cycles --reporter cycles --fix",
    "dead": "knip --fix",
    "lint": "bun run eslint --fix"
  },
  "prepare": "simple-git-hooks",
  "overrides": {
    "@fluentui/react-motion": "9.16.4"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.3.2",
    "@fluentui-contrib/react-draggable-dialog": "^0.2.6",
    "@fluentui/react-components": "^9.75.2",
    "@fluentui/react-icons": "^2.0.347",
    "@fluentui/tokens": "^1.0.0-alpha.24",
    "@freik/fluent9-tools": "^0.2.4",
    "@freik/sync": "^0.4.10",
    "@freik/typechk": "^0.10.0",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "jotai": "^3.0.2",
    "jotai-family": "^1.1.0",
    "jotai-optics": "^0.4.0",
    "optics-ts": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^9.0.0",
    "@freik/workspace": "^0.8.1",
    "@happy-dom/global-registrator": "21.0.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-java": "^2.12.0",
    "simple-git-hooks": "^2.14.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0"
  },
  " //-1": "Configuration stuff for Prettier:",
  "prettier": {
    "endOfLine": "lf",
    "printWidth": 80,
    "trailingComma": "all",
    "singleQuote": true,
    "proseWrap": "always",
    "tabWidth": 2,
    "useTabs": false,
    "bracketSameLine": true,
    "arrowParens": "always",
    "plugins": [
      "prettier-plugin-java",
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^bun:.*$",
      "^node:.*$",
      "^react$",
      "^react-dom$",
      "^react-dom/client$",
      "^.*jotai.*$",
      "",
      "<THIRD_PARTY_MODULES>",
      "^@freik/.*$",
      "",
      "^(?!.*[.]css$)[./].*$",
      "",
      ".css$"
    ],
    "overrides": [
      {
        "files": "*.java",
        "options": {
          "tabWidth": 4,
          "printWidth": 100,
          "arrowParens": "avoid"
        }
      }
    ]
  },
  " //-2": "Configuration stuff for knip:",
  "knip": {
    "entry": [
      "src/entry.ts",
      "src/client/FrontEnd.tsx"
    ],
    "cycles": {
      "dynamicImports": true
    }
  },
  " //-3": "Hook configuration stuff:",
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "pre-push": "bun run check"
  },
  " //-4": "Which files get formatted with what:",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,java,md}": [
      "prettier --write"
    ]
  }
}
